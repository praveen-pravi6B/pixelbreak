{
  "name": "pixelbreak-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first responsive breakpoint detection and visual regression testing",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm -r run lint",
    "typecheck": "tsc -b",
    "demo": "pnpm --filter @pixelbreak/broken-demo dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "playwright", "@playwright/test"]
  }
}
