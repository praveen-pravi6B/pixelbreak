{
  "name": "@pixelbreak/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pixelbreak": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "node ./dist/cli.js",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@pixelbreak/ai-engine": "workspace:*",
    "@pixelbreak/config": "workspace:*",
    "@pixelbreak/contracts": "workspace:*",
    "@pixelbreak/git-integration": "workspace:*",
    "@pixelbreak/layout-analyzer": "workspace:*",
    "@pixelbreak/policy-engine": "workspace:*",
    "@pixelbreak/visual-diff": "workspace:*",
    "commander": "^13.1.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
